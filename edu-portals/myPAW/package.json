{
  "name": "mypaw-production-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @mypaw/web-public dev",
    "build": "pnpm --filter @mypaw/web-public build",
    "preview": "pnpm --filter @mypaw/web-public preview",
    "lint": "pnpm --filter @mypaw/web-public lint"
  },
  "workspaces": [
    "01_Presentation-Layer/Multi-System/Browser-System/web-apps/*",
    "01_Presentation-Layer/Multi-System/Handheld-System/mobile-apps/*",
    "packages/*"
  ]
}
